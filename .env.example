# ==============================================================================
# QueueX Environment Configuration
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# DO NOT commit .env.local or real secrets to version control.
# ==============================================================================

# Application
NEXT_PUBLIC_APP_NAME=QueueX
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Firebase Client SDK Configuration (Public)
# Obtain from: Firebase Console -> Project Settings -> General -> Your apps -> Web app
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ------------------------------------------------------------------------------
# Firebase Admin SDK Configuration (Server-Side ONLY)
# Obtain from: Firebase Console -> Project Settings -> Service accounts -> Generate new private key
#
# IMPORTANT:
# - Never prefix with NEXT_PUBLIC_
# - Never commit service account credentials
# - In FIREBASE_PRIVATE_KEY, keep or wrap escaped newlines ("\n")
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
