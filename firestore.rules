rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // =========================================================================
    // QueueX Cloud Firestore Security Rules (Stage F0.3)
    // =========================================================================
    // Multi-tenant hospital data model:
    // /hospitals/{hospitalId}/{collectionName}/{docId}
    //
    // By default, direct client-side read/write is disallowed across all collections
    // to safeguard clinical records, triage tokens, and consultation history.
    //
    // All trusted operational logic, live queue state modifications, and event logging
    // are executed via Next.js Route Handlers using the Firebase Admin SDK.
    //
    // Role-based client rules (staff, doctors, kiosk tokens) will be introduced in
    // subsequent roadmap features alongside user authentication.
    // =========================================================================

    match /hospitals/{hospitalId} {
      allow read, write: if false;

      match /{subcollection}/{docId} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
